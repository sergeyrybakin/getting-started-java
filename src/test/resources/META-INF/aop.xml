<?xml version="1.0" encoding="UTF-8"?>
<!-- Конфигурация AspectJ для javaagent (aspectjweaver): аспекты Allure @Step/@Attachment
     из allure-java-commons. Копия META-INF/aop-ajc.xml из allure-junit-platform,
     переименованная в aop.xml — имя, которое читает AspectJ javaagent. -->
<aspectj>
    <weaver options="-warn:none -Xlint:ignore"/>
    <aspects>
        <aspect name="io.qameta.allure.aspects.StepsAspects"/>
        <aspect name="io.qameta.allure.aspects.AttachmentsAspects"/>
    </aspects>
</aspectj>
